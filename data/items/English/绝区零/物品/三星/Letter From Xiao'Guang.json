    "detail": {
      "id": 4000201,
      "name": "Letter From Xiao'Guang",
      "desc": "Ye Shunguang had left some old belongings in Failume Heights, but thankfully with your help, they were all recovered. To show gratitude, Xiao'Guang left you a letter explaining the origins of these items — it seems he has something special he wants to tell you...",
      "desc2": "Attached to the letter was a delicate feather, a group photo of the Yunkui Summit folks, a broken peace knot, a heavily revised recipe, a handwritten guide for Yunkui Summit newcomers, and a burnt-out floating lantern... These old items carry Xiao'Guang's cherished memories of Yunkui Summit, and she hopes you can keep them safe for her.",
      "class": {
        "72": "MESSAGE"
      },
      "rarity": 3,
      "icon_path": "Assets/NapResources/UI/Sprite/A1DynamicLoad/ItemIcon/UnPacker/2.5Preregistration.png"
