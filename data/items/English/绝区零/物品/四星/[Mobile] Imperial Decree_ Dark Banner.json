    "detail": {
      "id": 1321001,
      "name": "[Mobile] Imperial Decree: Dark Banner",
      "desc": "When the active character lands a heavy attack with <color=#FFFFFF>Assist Follow-Up</color>, <color=#FFFFFF>EX Special Attack</color>, <color=#FFFFFF>Ultimate</color>, or triggers <color=#FFFFFF>Perfect Dodge</color>, it will trigger <color=#FFFFFF>Tag Assist</color> for the next character. Press <IconMap:Icon_Switch> at this moment, and the next character will perform a <color=#FFFFFF>Quick Assist</color> centered on the enemy. <color=#FFFFFF>Tag Assist</color> won't switch the current active character, and the damage dealt is considered <color=#FFFFFF>Aftershock</color> DMG. When a character performs a <color=#FFFFFF>Tag Assist</color>, it provides 1 stack of <color=#FFFFFF>Comrade</color> to the whole squad, stacking up to 5 times and lasting 20s. Repeated triggers reset the duration. Each stack of <color=#FFFFFF>Comrade</color> increases <color=#2BAD00>Anomaly Proficiency by 20</color> and <color=#2BAD00>Anomaly Buildup Rate by 10%</color> for <color=#FFFFFF>Anomaly</color> specialty Agents; increases <color=#2BAD00>Impact by 4%</color> for Stun specialty Agents; increases <color=#2BAD00>CRIT Rate by 5%</color> and <color=#2BAD00>CRIT DMG by 10%</color> for Attack specialty Agents; increases <color=#2BAD00>Energy Generation Rate by 7.5%</color> for Support specialty Agents; increases <color=#2BAD00>shield efficiency by 10%</color> for Defense specialty Agents; and increases <color=#2BAD00>Sheer DMG by 7%</color> for Rupture specialty Agents.",
      "desc2": "",
